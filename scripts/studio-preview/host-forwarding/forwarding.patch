+    }
+
+    pub fn cancel_managed_turn(&self, expected_turn: &str) -> Option<bool> {
+        if !self.has_managed_operation_capability() {
+            return None;
+        }
+        Some(
+            self.protocol
+                .cancel_managed_turn(expected_turn, || self.permission_router.cancel_all()),
+        )
+    }
