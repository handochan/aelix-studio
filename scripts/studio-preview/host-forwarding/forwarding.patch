diff --git a/crates/aionui-conversation/src/service/operations.rs b/crates/aionui-conversation/src/service/operations.rs
new file mode 100644
index 0000000..3d6cc76
--- /dev/null
+++ b/crates/aionui-conversation/src/service/operations.rs
@@ -0,0 +1,371 @@
+//! HTTP admission/status without prompt replay. Stored records contain only
+//! opaque IDs, keyed fingerprints and allowlisted outcome state.
+use super::ConversationService;
+use crate::ConversationError;
+use aionui_ai_agent::{IWorkerTaskManager, ManagedExecutionBinding};
+use aionui_api_types::{
+    HostOperationKey, HostOperationReceipt, MANAGED_OPERATION_SCHEMA, ManagedOperationContext, SendMessageRequest,
+    SendMessageResponse, managed_operation_token,
+};
+use aionui_db::{DbError, ManagedOperationRow};
+use std::sync::{Arc, Weak};
+use tokio::sync::Mutex;
+
+pub(super) fn db_error(error: DbError) -> ConversationError {
+    match error {
+        DbError::Conflict(_) => ConversationError::ManagedOperationConflict,
+        _ => ConversationError::ManagedOperationUnavailable,
+    }
+}
+
+pub(super) fn request(req: &SendMessageRequest) -> Result<Option<(HostOperationKey, Vec<u8>)>, ConversationError> {
+    let Some(key) = req.operation.clone() else {
+        return Ok(None);
+    };
+    if key.schema != MANAGED_OPERATION_SCHEMA
+        || !managed_operation_token(&key.id)
+        || !managed_operation_token(&key.host_store_id)
+    {
+        return Err(ConversationError::bad_request("Invalid managed operation key"));
+    }
+    let body = serde_json::to_vec(&(&req.content, &req.files, &req.sessions, &req.inject_skills, req.hidden))
+        .map_err(|_| ConversationError::bad_request("Invalid managed operation body"))?;
+    if body.len() > 16 * 1024 * 1024 {
+        return Err(ConversationError::bad_request(
+            "Managed operation body exceeds frame budget",
+        ));
+    }
+    Ok(Some((key, body)))
+}
+
+pub(crate) fn receipt(row: &ManagedOperationRow, replayed: bool) -> HostOperationReceipt {
+    HostOperationReceipt {
+        schema: MANAGED_OPERATION_SCHEMA.into(),
+        id: row.operation_id.clone(),
+        host_store_id: row.host_store_id.clone(),
+        msg_id: row.msg_id.clone(),
+        turn_id: row.turn_id.clone(),
+        state: row.state.clone(),
+        effects_unknown: row.state != "completed",
+        automatic_retry: false,
+        replayed,
+    }
+}
+
+pub(crate) fn context(conversation: &str, row: &ManagedOperationRow) -> ManagedOperationContext {
+    ManagedOperationContext {
+        schema: MANAGED_OPERATION_SCHEMA.into(),
+        id: row.operation_id.clone(),
+        store_id: row.adapter_store_id.clone(),
+        conversation_id: conversation.into(),
+        turn_id: row.turn_id.clone(),
+        generation: row.generation.clone(),
+    }
+}
+
+fn observed_state(value: &serde_json::Value, expected: &ManagedOperationContext) -> Result<String, ConversationError> {
+    let row = value
+        .get("operation")
+        .ok_or(ConversationError::ManagedOperationUnavailable)?;
+    for (name, expected) in [
+        ("schema", expected.schema.as_str()),
+        ("id", &expected.id),
+        ("storeId", &expected.store_id),
+        ("conversationId", &expected.conversation_id),
+        ("turnId", &expected.turn_id),
+        ("generation", &expected.generation),
+    ] {
+        if row.get(name).and_then(|v| v.as_str()) != Some(expected) {
+            return Err(ConversationError::ManagedOperationUnavailable);
+        }
+    }
+    let state = row
+        .get("state")
+        .and_then(|v| v.as_str())
+        .ok_or(ConversationError::ManagedOperationUnavailable)?;
+    if ![
+        "pending",
+        "completed",
+        "cancelled",
+        "failed",
+        "interrupted",
+        "not_found",
+    ]
+    .contains(&state)
+        || row.get("automaticRetry").and_then(|v| v.as_bool()) != Some(false)
+        || row.get("effectsUnknown").and_then(|v| v.as_bool()) != Some(state != "completed")
+    {
+        return Err(ConversationError::ManagedOperationUnavailable);
+    }
+    match state {
+        "completed"
+            if row.get("code").and_then(|v| v.as_str()) != Some("end_turn")
+                || row.get("stopReason").and_then(|v| v.as_str()) != Some("end_turn") =>
+        {
+            return Err(ConversationError::ManagedOperationUnavailable);
+        }
+        "cancelled"
+            if row.get("code").and_then(|v| v.as_str()) != Some("cancelled")
+                || row.get("stopReason").and_then(|v| v.as_str()) != Some("cancelled") =>
+        {
+            return Err(ConversationError::ManagedOperationUnavailable);
+        }
+        "failed" | "interrupted"
+            if ![
+                Some("owner_lost"),
+                Some("timeout"),
+                Some("transport_closed"),
+                Some("dispatch_failed"),
+                Some("native_error"),
+            ]
+            .contains(&row.get("code").and_then(|v| v.as_str())) =>
+        {
+            return Err(ConversationError::ManagedOperationUnavailable);
+        }
+        _ => {}
+    }
+    // Absence may race a pre-dispatch transport buffer. It proves neither
+    // writer exit nor no effects: retain uncertainty without a terminal/replay.
+    Ok(if state == "not_found"
+        || (state == "pending" && row.get("executionObservation").and_then(|v| v.as_str()) == Some("recovery_waiting"))
+    {
+        "recovery_waiting"
+    } else {
+        state
+    }
+    .into())
+}
+
+impl ConversationService {
+    pub(super) async fn managed_host_capability(
+        &self,
+        agent: &aionui_ai_agent::AgentInstance,
+    ) -> Result<Option<aionui_api_types::HostOperationCapability>, ConversationError> {
+        if agent
+            .managed_execution_binding()
+            .await
+            .map_err(|_| ConversationError::ManagedOperationUnavailable)?
+            .is_none()
+        {
+            return Ok(None);
+        }
+        Ok(Some(aionui_api_types::HostOperationCapability {
+            schema: MANAGED_OPERATION_SCHEMA.into(),
+            host_store_id: self.conversation_repo.operation_namespace().await.map_err(db_error)?,
+        }))
+    }
+
+    pub(super) fn managed_admission_lock(&self, conversation: &str) -> Arc<Mutex<()>> {
+        let mut locks = self.managed_admissions.lock().unwrap();
+        locks.retain(|_, lock| lock.strong_count() > 0);
+        if let Some(lock) = locks.get(conversation).and_then(Weak::upgrade) {
+            return lock;
+        }
+        let lock = Arc::new(Mutex::new(()));
+        locks.insert(conversation.to_owned(), Arc::downgrade(&lock));
+        lock
+    }
+
+    pub(super) async fn managed_new_binding(
+        &self,
+        conversation: &str,
+        tasks: &Arc<dyn IWorkerTaskManager>,
+    ) -> Result<ManagedExecutionBinding, ConversationError> {
+        // Only an actually negotiated runtime can admit keyed work. The UI's
+        // existing explicit runtime/ensure path performs warmup beforehand.
+        tasks
+            .get_task(conversation)
+            .ok_or(ConversationError::ManagedOperationUnavailable)?
+            .managed_execution_binding()
+            .await
+            .map_err(|_| ConversationError::ManagedOperationUnavailable)?
+            .ok_or(ConversationError::ManagedOperationUnavailable)
+    }
+
+    async fn refresh_managed_operation(
+        &self,
+        user: &str,
+        conversation: &str,
+        row: ManagedOperationRow,
+    ) -> Result<ManagedOperationRow, ConversationError> {
+        if [
+            "completed",
+            "cancelled",
+            "cancelled_before_dispatch",
+            "failed",
+            "interrupted",
+        ]
+        .contains(&row.state.as_str())
+        {
+            return Ok(row);
+        }
+        let operation = context(conversation, &row);
+        let live = if let Some(agent) = self.task_manager.get_task(conversation) {
+            if agent.managed_cancelled_before_dispatch(&row.acp_session_id, &operation) {
+                self.conversation_repo
+                    .settle_operation(user, conversation, &row.operation_id, "cancelled_before_dispatch")
+                    .await
+                    .map_err(db_error)?;
+                return self
+                    .conversation_repo
+                    .lookup_operation(user, conversation, &row.operation_id, &row.host_store_id, None)
+                    .await
+                    .map_err(db_error)?
+                    .ok_or(ConversationError::ManagedOperationUnavailable);
+            }
+            agent
+                .managed_operation_status(&row.acp_session_id, &operation)
+                .await
+                .ok()
+        } else {
+            None
+        };
+        let observed = match live {
+            Some(value) => Ok(value),
+            None => {
+                let metadata_row = self
+                    .agent_metadata_repo
+                    .get_for_user(user, &row.metadata_id)
+                    .await
+                    .map_err(db_error)?
+                    .ok_or(ConversationError::ManagedOperationUnavailable)?;
+                let metadata = aionui_ai_agent::registry::managed_operation_metadata(metadata_row)
+                    .ok_or(ConversationError::ManagedOperationUnavailable)?;
+                let conversation_row = self
+                    .conversation_repo
+                    .get(user, conversation)
+                    .await
+                    .map_err(db_error)?
+                    .ok_or(ConversationError::ManagedOperationUnavailable)?;
+                let workspace = crate::session_mentions::workspace_from_extra(&conversation_row.extra)
+                    .ok_or(ConversationError::ManagedOperationUnavailable)?;
+                let binding = aionui_ai_agent::managed_command_binding(&metadata, &workspace)
+                    .map_err(|_| ConversationError::ManagedOperationUnavailable)?;
+                if !self
+                    .conversation_repo
+                    .operation_command_matches(user, conversation, &row.operation_id, &binding)
+                    .await
+                    .map_err(db_error)?
+                {
+                    return Err(ConversationError::ManagedOperationUnavailable);
+                }
+                aionui_ai_agent::query_managed_operation_status_only(
+                    &metadata,
+                    &workspace,
+                    &row.acp_session_id,
+                    &operation,
+                )
+                .await
+                .map_err(|_| ConversationError::ManagedOperationUnavailable)
+            }
+        }?;
+        let state = observed_state(&observed, &operation)?;
+        self.conversation_repo
+            .settle_operation(user, conversation, &row.operation_id, &state)
+            .await
+            .map_err(db_error)?;
+        self.conversation_repo
+            .lookup_operation(user, conversation, &row.operation_id, &row.host_store_id, None)
+            .await
+            .map_err(db_error)?
+            .ok_or(ConversationError::ManagedOperationUnavailable)
+    }
+
+    pub(super) async fn managed_duplicate_response(
+        &self,
+        user: &str,
+        conversation: &str,
+        row: ManagedOperationRow,
+    ) -> Result<SendMessageResponse, ConversationError> {
+        let row = self.refresh_managed_operation(user, conversation, row).await?;
+        let mut response = self
+            .send_message_response(conversation, row.msg_id.clone(), row.turn_id.clone())
+            .await;
+        response.operation = Some(receipt(&row, true));
+        Ok(response)
+    }
+
+    pub async fn managed_operation_status(
+        &self,
+        user: &str,
+        conversation: &str,
+        key: &HostOperationKey,
+    ) -> Result<HostOperationReceipt, ConversationError> {
+        // Ownership precedes even namespace/key lookup and any process launch.
+        self.conversation_repo
+            .get(user, conversation)
+            .await?
+            .ok_or_else(|| ConversationError::NotFound {
+                id: conversation.into(),
+            })?;
+        if key.schema != MANAGED_OPERATION_SCHEMA
+            || !managed_operation_token(&key.id)
+            || !managed_operation_token(&key.host_store_id)
+        {
+            return Err(ConversationError::bad_request("Invalid managed operation key"));
+        }
+        let row = self
+            .conversation_repo
+            .lookup_operation(user, conversation, &key.id, &key.host_store_id, None)
+            .await
+            .map_err(db_error)?;
+        let Some(row) = row else {
+            return Ok(HostOperationReceipt {
+                schema: MANAGED_OPERATION_SCHEMA.into(),
+                id: key.id.clone(),
+                host_store_id: key.host_store_id.clone(),
+                msg_id: String::new(),
+                turn_id: String::new(),
+                state: "not_found".into(),
+                effects_unknown: true,
+                automatic_retry: false,
+                replayed: false,
+            });
+        };
+        let row = self.refresh_managed_operation(user, conversation, row).await?;
+        Ok(receipt(&row, true))
+    }
+
+    pub(crate) async fn settle_managed_turn(&self, user: &str, conversation: &str, key: &HostOperationKey) {
+        if self.managed_operation_status(user, conversation, key).await.is_err() {
+            // Keep the durable pending/accepted row. No invented terminal and no
+            // automatic replay: explicit status can reconcile after reconnect.
+            tracing::warn!(
+                conversation_id = conversation,
+                operation_id = key.id,
+                "Managed outcome remains unavailable"
+            );
+        }
+    }
+
+    pub(crate) async fn record_managed_not_dispatched(
+        &self,
+        user: &str,
+        conversation: &str,
+        operation: &ManagedOperationContext,
+    ) {
+        let result = async {
+            let store = self.conversation_repo.operation_namespace().await.map_err(db_error)?;
+            let row = self
+                .conversation_repo
+                .lookup_operation(user, conversation, &operation.id, &store, None)
+                .await
+                .map_err(db_error)?
+                .ok_or(ConversationError::ManagedOperationUnavailable)?;
+            if context(conversation, &row) != *operation {
+                return Err(ConversationError::ManagedOperationUnavailable);
+            }
+            self.conversation_repo
+                .settle_operation(user, conversation, &operation.id, "cancelled_before_dispatch")
+                .await
+                .map_err(db_error)
+        }
+        .await;
+        if result.is_err() {
+            tracing::warn!(
+                conversation_id = conversation,
+                "Pre-dispatch cancellation outcome remains unavailable"
+            );
+        }
+    }
+}
