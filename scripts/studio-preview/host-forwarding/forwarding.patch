diff --git a/crates/aionui-db/migrations/044_managed_operations.sql b/crates/aionui-db/migrations/044_managed_operations.sql
new file mode 100644
index 0000000..aa018ed
--- /dev/null
+++ b/crates/aionui-db/migrations/044_managed_operations.sql
@@ -0,0 +1,26 @@
+-- One durable host epoch/key; no prompt/output/credential columns.
+CREATE TABLE IF NOT EXISTS managed_operation_meta (
+    singleton INTEGER PRIMARY KEY CHECK(singleton = 1),
+    store_id TEXT NOT NULL CHECK(length(store_id) = 32),
+    fingerprint_key BLOB NOT NULL CHECK(typeof(fingerprint_key) = 'blob' AND length(fingerprint_key) = 32),
+    root_id TEXT,
+    file_id TEXT
+);
+INSERT INTO managed_operation_meta VALUES(1, lower(hex(randomblob(16))), randomblob(32), NULL, NULL);
+CREATE TABLE IF NOT EXISTS managed_operations (
+    user_id TEXT NOT NULL,
+    conversation_id TEXT NOT NULL REFERENCES conversations(id) ON DELETE CASCADE,
+    operation_id TEXT NOT NULL CHECK(length(operation_id) BETWEEN 1 AND 128),
+    fingerprint BLOB NOT NULL CHECK(typeof(fingerprint) = 'blob' AND length(fingerprint) = 32),
+    command_fingerprint BLOB NOT NULL CHECK(typeof(command_fingerprint) = 'blob' AND length(command_fingerprint) = 32),
+    msg_id TEXT NOT NULL,
+    turn_id TEXT NOT NULL,
+    adapter_store_id TEXT NOT NULL,
+    acp_session_id TEXT NOT NULL,
+    generation TEXT NOT NULL,
+    metadata_id TEXT NOT NULL,
+    state TEXT NOT NULL CHECK(state IN ('accepted','pending','recovery_waiting','completed','cancelled','cancelled_before_dispatch','failed','interrupted')),
+    created_at INTEGER NOT NULL,
+    updated_at INTEGER NOT NULL,
+    PRIMARY KEY(conversation_id, operation_id)
