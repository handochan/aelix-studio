+#[tokio::test(start_paused = true)]
+async fn single_reverse_request_gets_explicit_deadline_error_and_connection_survives() {
+    let (client_wire, agent_wire) = Channel::duplex();
+    let budget = Arc::new(Semaphore::new(1));
+    let client_budget = budget.clone();
+    let (entered_tx, entered_rx) = oneshot::channel();
+    let entered = Arc::new(std::sync::Mutex::new(Some(entered_tx)));
+    let client = tokio::spawn(async move {
+        Client
+            .builder()
+            .on_receive_request(
+                async move |request: UntypedMessage, responder, cx| {
+                    if request.method == "_review/deadline" {
+                        let entered = entered.lock().unwrap().take();
+                        dispatch(cx, &client_budget, responder, async move {
+                            entered.unwrap().send(()).unwrap();
+                            std::future::pending::<Result<serde_json::Value, agent_client_protocol::Error>>().await
+                        })
+                    } else {
+                        let _ = responder.respond_with_error(unsupported());
+                        Ok(())
+                    }
+                },
+                on_receive_request!(),
+            )
+            .connect_with(client_wire, async |_: ConnectionTo<Agent>| {
+                std::future::pending::<Result<(), agent_client_protocol::Error>>().await
+            })
+            .await
+    });
+    let (ready_tx, ready_rx) = oneshot::channel();
+    let agent = tokio::spawn(async move {
+        Agent
+            .builder()
+            .connect_with(agent_wire, async move |cx: ConnectionTo<Client>| {
+                ready_tx.send(cx).unwrap();
+                std::future::pending::<Result<(), agent_client_protocol::Error>>().await
+            })
+            .await
+    });
+    let connection = ready_rx.await.unwrap();
+    let request = connection.send_request(
+        UntypedMessage::new("_review/deadline", serde_json::json!({"secret":"SYNTHETIC_PRIVATE"})).unwrap(),
+    );
+    let task = tokio::spawn(async move { request.block_task().await });
+    entered_rx.await.unwrap();
+    tokio::time::advance(REVERSE_DEADLINE + Duration::from_secs(1)).await;
+    let error = tokio::time::timeout(Duration::from_secs(1), task)
+        .await
+        .unwrap()
+        .unwrap()
+        .unwrap_err();
+    assert_eq!(
+        error.data.unwrap(),
+        serde_json::json!({"kind":"client_request_deadline_exceeded","retry":false})
+    );
+    assert_eq!(budget.available_permits(), 1);
+    let followup = connection
+        .send_request(UntypedMessage::new("_review/followup", serde_json::json!({})).unwrap())
+        .block_task()
+        .await
+        .unwrap_err();
+    assert_eq!(followup.data.unwrap()["kind"], "unsupported_client_action");
+    client.abort();
+    agent.abort();
+    let _ = tokio::join!(client, agent);
+}
