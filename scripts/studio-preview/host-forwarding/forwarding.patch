+    ) -> bool {
+        self.protocol.managed_cancelled_before_dispatch(sid, operation)
+    }
+
+    pub async fn managed_execution_binding(&self) -> Result<Option<crate::ManagedExecutionBinding>, AgentError> {
+        if self.protocol.managed_capability()?.is_none() {
+            return Ok(None);
+        }
+        let status = crate::managed_status_command(&self.params.metadata, &self.params.workspace.path)?;
+        let actual = &self.params.command_spec;
+        if actual.args != self.params.metadata.args
+            || std::fs::canonicalize(&actual.command).ok() != std::fs::canonicalize(&status.command).ok()
+        {
+            return Err(AgentError::conflict("Managed operation launch binding unavailable"));
+        }
+        let sid = self.ensure_session_opened().await?;
+        let (observed_sid, scope) = self
+            .protocol
+            .managed_scope()
+            .ok_or_else(|| AgentError::conflict("Managed operation worker binding unavailable"))?;
+        if sid != observed_sid {
+            return Err(AgentError::conflict("Managed operation session binding changed"));
+        }
+        Ok(Some(crate::ManagedExecutionBinding {
+            session_id: sid,
+            scope,
+            metadata_id: self.params.metadata.id.clone(),
+            command_binding: crate::managed_command_binding(&self.params.metadata, &self.params.workspace.path)?,
+        }))
+    }
+
+    pub async fn managed_operation_status(
+        &self,
+        sid: &str,
+        operation: &aionui_api_types::ManagedOperationContext,
+    ) -> Result<serde_json::Value, AgentError> {
+        // Lookup never calls ensure_session_opened or follows a resume anchor.
+        self.protocol
+            .operation_status(sid, operation)
+            .await
+            .map_err(AgentError::from)
+    }
