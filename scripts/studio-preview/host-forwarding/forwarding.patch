+//! Bounded connection-owned reverse request dispatch.
+//!
+//! SDK 2.0.0 `jsonrpc.rs:784-845` runs request handlers on one event loop;
+//! `ConnectionTo::spawn` owns tasks until connection teardown. Consent and
+//! terminal waits must therefore leave that loop immediately. Expected request
+//! failures are replies, never unrelated errors returned by a spawned task.
+use std::{future::Future, sync::Arc, time::Duration};
+
+use agent_client_protocol::{Agent, ConnectionTo, JsonRpcResponse, Responder};
+use tokio::sync::Semaphore;
+pub mod operation;
+
+pub(super) const MAX_REVERSE_REQUESTS: usize = 32;
+pub(super) const REVERSE_DEADLINE: Duration = Duration::from_secs(300);
+pub(super) const MAX_FRAME_BYTES: usize = 16 * 1024 * 1024;
+
+pub(super) fn unsupported() -> agent_client_protocol::Error {
+    agent_client_protocol::Error::method_not_found().data(serde_json::json!({
+        "kind": "unsupported_client_action", "retry": false
+    }))
+}
+
+pub(super) fn dispatch<R, Fut>(
+    connection: ConnectionTo<Agent>,
+    budget: &Arc<Semaphore>,
+    responder: Responder<R>,
+    handler: Fut,
+) -> Result<(), agent_client_protocol::Error>
+where
+    R: JsonRpcResponse + Send + 'static,
+    Fut: Future<Output = Result<R, agent_client_protocol::Error>> + Send + 'static,
+{
+    let Ok(permit) = Arc::clone(budget).try_acquire_owned() else {
+        let _ = responder.respond_with_error(
+            agent_client_protocol::Error::internal_error()
+                .data(serde_json::json!({"kind": "client_capacity_exceeded", "retry": false})),
+        );
+        return Ok(());
+    };
+    connection.spawn(async move {
+        let _permit = permit;
+        // SDK2.0.0 ResponderDropGuard only settles abandoned BATCH slots.
+        // Retain the single-request responder until an explicit result/error;
+        // returning Ok keeps expected failures from closing the connection.
+        match tokio::time::timeout(REVERSE_DEADLINE, handler).await {
+            Ok(Ok(response)) => {
+                let _ = responder.respond(response);
+            }
+            Ok(Err(error)) => {
+                let _ = responder.respond_with_error(error);
+            }
+            Err(_) => {
+                let _ = responder.respond_with_error(
+                    agent_client_protocol::Error::internal_error()
+                        .data(serde_json::json!({"kind":"client_request_deadline_exceeded","retry":false})),
+                );
+            }
+        }
+        Ok(())
+    })
+}
+
+#[cfg(test)]
+mod tests;
