+#[test]
+fn status_lookup_never_installs_a_missing_runtime() {
+    let temporary = tempfile::tempdir().unwrap();
+    let missing = temporary.path().join("absent");
+    assert!(existing_managed_runtime_at(&missing).is_none());
+    assert!(!missing.exists());
+}
+
+#[test]
+fn status_lookup_reads_existing_pinned_files_without_executing_them() {
+    let temporary = tempfile::tempdir().unwrap();
+    let root = temporary.path();
+    let directory = root.join(platform_spec().unwrap().directory_name());
+    let layout = current_managed_node_archive_layout();
+    let node = managed_node_path_for_layout(&directory, layout);
+    // Empty, non-executable files deliberately cannot pass a process probe.
+    write_file(&node);
+    write_file(&managed_npm_cli_path_for_layout(&directory, layout));
+    write_file(&managed_npx_cli_path_for_layout(&directory, layout));
+    #[cfg(unix)]
+    {
+        use std::os::unix::fs::PermissionsExt;
+        let marker = root.join("execution-marker");
+        std::fs::write(
+            &node,
+            format!("#!/bin/sh\nprintf executed > '{}'\nexit 99\n", marker.display()),
+        )
+        .unwrap();
+        std::fs::set_permissions(&node, std::fs::Permissions::from_mode(0o755)).unwrap();
+    }
+    let before = std::fs::read_dir(root).unwrap().count();
+    assert_eq!(existing_managed_runtime_at(root).unwrap().node_path, node);
+    assert_eq!(std::fs::read_dir(root).unwrap().count(), before);
+    assert!(!root.join("execution-marker").exists());
+    let npm = managed_npm_cli_path_for_layout(&directory, layout);
+    std::fs::remove_file(&npm).unwrap();
+    assert!(existing_managed_runtime_at(root).is_none());
+    write_file(&npm);
+    let npx = managed_npx_cli_path_for_layout(&directory, layout);
+    std::fs::remove_file(&npx).unwrap();
+    assert!(existing_managed_runtime_at(root).is_none());
+    write_file(&npx);
+    std::fs::remove_file(node).unwrap();
+    assert!(existing_managed_runtime_at(root).is_none());
+}
