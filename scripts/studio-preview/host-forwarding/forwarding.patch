+use super::tests::{sample_conversation, sample_message, setup};
+use super::*;
+use crate::AdmitManagedOperation;
+const USER: &str = "system_default_user";
+
+#[tokio::test]
+async fn managed_adoption_transfers_owner_without_resetting_store_or_original_fences() {
+    use crate::{ExternalUserProjection, IUserRepository, SqliteUserRepository, UserType};
+    let (repo, db) = setup().await;
+    let conversation = sample_conversation(USER);
+    repo.create(&conversation).await.unwrap();
+    let store = repo.operation_namespace().await.unwrap();
+    let message = sample_message(&conversation.id);
+    repo.admit_operation(&admission(&conversation.id, &store, &message, b"SYNTHETIC_REQUEST"))
+        .await
+        .unwrap();
+    let before: (String, Vec<u8>) = sqlx::query_as("SELECT store_id,fingerprint_key FROM managed_operation_meta")
+        .fetch_one(db.pool())
+        .await
+        .unwrap();
+    let users = SqliteUserRepository::new(db.pool().clone());
+    let owner = users
+        .ensure_external_user(UserType::Aionpro, "synthetic-owner", ExternalUserProjection::default())
+        .await
+        .unwrap();
+    users.adopt_system_default_data(&owner.id).await.unwrap();
+    let after: (String, Vec<u8>) = sqlx::query_as("SELECT store_id,fingerprint_key FROM managed_operation_meta")
+        .fetch_one(db.pool())
+        .await
+        .unwrap();
+    assert_eq!(before, after);
+    assert!(
+        repo.lookup_operation(USER, &conversation.id, "operation-1", &store, None)
+            .await
+            .unwrap()
+            .is_none()
+    );
+    let original = repo
+        .lookup_operation(&owner.id, &conversation.id, "operation-1", &store, None)
+        .await
+        .unwrap()
+        .unwrap();
+    assert_eq!(
+        (original.msg_id, original.turn_id, original.generation),
+        (message.id, "turn-1".into(), "original-generation".into())
+    );
+    // A new owner can inspect the original record, but cannot start a status-only
+    // process using a command authenticated under the former owner's scope.
+    assert!(
+        !repo
+            .operation_command_matches(
+                &owner.id,
+                &conversation.id,
+                "operation-1",
+                b"SYNTHETIC_COMMAND_AUTH_MUST_NOT_BE_STORED"
+            )
+            .await
+            .unwrap()
+    );
+    // The accepted request belonged to the former owner. A changed ownership
+    // scope cannot silently become another admission with that original key.
+    assert!(matches!(
+        repo.lookup_operation(
+            &owner.id,
+            &conversation.id,
+            "operation-1",
+            &store,
+            Some(b"SYNTHETIC_REQUEST")
+        )
+        .await,
+        Err(DbError::Conflict(_))
+    ));
+}
+
+fn admission<'a>(
+    conversation: &'a str,
+    store: &'a str,
+    message: &'a MessageRow,
+    body: &'a [u8],
+) -> AdmitManagedOperation<'a> {
+    AdmitManagedOperation {
+        user_id: USER,
+        conversation_id: conversation,
+        operation_id: "operation-1",
+        host_store_id: store,
+        canonical_request: body,
+        command_binding: b"SYNTHETIC_COMMAND_AUTH_MUST_NOT_BE_STORED",
+        message,
+        turn_id: "turn-1",
+        adapter_store_id: "original-store",
+        acp_session_id: "original-session",
+        generation: "original-generation",
+        metadata_id: "metadata-1",
+    }
+}
+
+#[tokio::test]
+async fn managed_admission_and_ordinary_message_commit_once_with_original_ids() {
+    let (repo, db) = setup().await;
+    let conversation = sample_conversation(USER);
+    repo.create(&conversation).await.unwrap();
+    let store = repo.operation_namespace().await.unwrap();
+    let message = sample_message(&conversation.id);
+    let first = repo
+        .admit_operation(&admission(&conversation.id, &store, &message, b"SYNTHETIC_REQUEST"))
+        .await
+        .unwrap();
+    let second_message = sample_message(&conversation.id);
+    let mut second = admission(&conversation.id, &store, &second_message, b"SYNTHETIC_REQUEST");
+    second.turn_id = "later-turn";
+    let duplicate = repo.admit_operation(&second).await.unwrap();
+    assert!(first.0 && !duplicate.0);
+    assert_eq!((duplicate.1.msg_id, duplicate.1.turn_id), (message.id, "turn-1".into()));
+    let count: i64 = sqlx::query_scalar("SELECT count(*) FROM messages WHERE conversation_id=?")
+        .bind(&conversation.id)
+        .fetch_one(db.pool())
+        .await
+        .unwrap();
+    assert_eq!(count, 1);
+}
+
+#[tokio::test]
+async fn managed_duplicate_conflicts_without_storing_raw_request_or_launch_credentials() {
+    let (repo, db) = setup().await;
+    let conversation = sample_conversation(USER);
+    repo.create(&conversation).await.unwrap();
+    let store = repo.operation_namespace().await.unwrap();
+    let message = sample_message(&conversation.id);
+    repo.admit_operation(&admission(&conversation.id, &store, &message, b"SYNTHETIC_SECRET_BODY"))
+        .await
+        .unwrap();
+    let changed = repo
+        .lookup_operation(USER, &conversation.id, "operation-1", &store, Some(b"DIFFERENT"))
+        .await;
+    assert!(matches!(changed, Err(DbError::Conflict(_))));
+    let row: sqlx::sqlite::SqliteRow = sqlx::query("SELECT * FROM managed_operations")
+        .fetch_one(db.pool())
+        .await
+        .unwrap();
+    for column in ["fingerprint", "command_fingerprint"] {
+        let value: Vec<u8> = row.try_get(column).unwrap();
+        assert_eq!(value.len(), 32);
+        assert!(!String::from_utf8_lossy(&value).contains("SYNTHETIC"));
+    }
+    assert!(
+        !repo
+            .operation_command_matches(USER, &conversation.id, "operation-1", b"CHANGED_COMMAND")
+            .await
+            .unwrap()
+    );
+}
+
+#[tokio::test]
+async fn managed_cross_user_lookup_and_admission_never_access_another_owner() {
+    let (repo, _) = setup().await;
+    let conversation = sample_conversation(USER);
+    repo.create(&conversation).await.unwrap();
+    let store = repo.operation_namespace().await.unwrap();
+    let message = sample_message(&conversation.id);
+    repo.admit_operation(&admission(&conversation.id, &store, &message, b"SYNTHETIC"))
+        .await
+        .unwrap();
+    assert!(
+        repo.lookup_operation("other-user", &conversation.id, "operation-1", &store, None)
+            .await
+            .unwrap()
+            .is_none()
+    );
+    let mut other = admission(&conversation.id, &store, &message, b"SYNTHETIC");
+    other.user_id = "other-user";
+    assert!(matches!(repo.admit_operation(&other).await, Err(DbError::NotFound(_))));
+}
+
+#[tokio::test]
+async fn managed_terminal_cannot_be_overwritten_by_late_pending_or_cleanup() {
+    let (repo, _) = setup().await;
+    let conversation = sample_conversation(USER);
+    repo.create(&conversation).await.unwrap();
+    let store = repo.operation_namespace().await.unwrap();
+    let message = sample_message(&conversation.id);
+    repo.admit_operation(&admission(&conversation.id, &store, &message, b"SYNTHETIC"))
+        .await
+        .unwrap();
+    repo.settle_operation(USER, &conversation.id, "operation-1", "completed")
+        .await
+        .unwrap();
+    for state in ["pending", "recovery_waiting", "interrupted"] {
+        repo.settle_operation(USER, &conversation.id, "operation-1", state)
+            .await
+            .unwrap();
+    }
+    assert_eq!(
+        repo.lookup_operation(USER, &conversation.id, "operation-1", &store, None)
+            .await
+            .unwrap()
+            .unwrap()
+            .state,
+        "completed"
+    );
+    assert!(
+        repo.lookup_operation(USER, &conversation.id, "operation-1", "different-store", None)
+            .await
+            .is_err()
+    );
+}
+
+#[tokio::test]
+async fn managed_same_directory_database_copy_cannot_restore_the_old_namespace() {
+    let temporary = tempfile::tempdir().unwrap();
+    let path = temporary.path().join("host.sqlite3");
+    let db = crate::init_database(&path).await.unwrap();
+    let repo = SqliteConversationRepository::new(db.pool().clone());
+    let store = repo.operation_namespace().await.unwrap();
+    // Publish a consistent SQLite snapshot before changing the main file's
+    // identity. A raw copy must not race WAL/checkpoint cleanup and fail for
+    // incidental short reads before the namespace fence is exercised.
+    let copy = temporary.path().join("copy.sqlite3");
+    sqlx::query("PRAGMA wal_checkpoint(TRUNCATE)")
+        .execute(db.pool())
+        .await
+        .unwrap();
+    sqlx::query("VACUUM INTO ?")
+        .bind(copy.to_str().unwrap())
+        .execute(db.pool())
+        .await
+        .unwrap();
+    db.pool().close().await;
+    drop(repo);
+    drop(db);
+    let retained = temporary.path().join("retained.sqlite3");
+    std::fs::rename(&path, &retained).unwrap();
+    std::fs::rename(&copy, &path).unwrap();
+    let db = crate::init_database(&path).await.unwrap();
+    let repo = SqliteConversationRepository::new(db.pool().clone());
+    assert!(repo.operation_namespace().await.is_err());
+    let after: String = sqlx::query_scalar("SELECT store_id FROM managed_operation_meta")
+        .fetch_one(db.pool())
+        .await
+        .unwrap();
+    assert_eq!(store, after);
+    db.pool().close().await;
+}
