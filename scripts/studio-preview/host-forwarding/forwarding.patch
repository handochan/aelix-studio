@@ -0,0 +1,81 @@
+//! Physical identity of the host SQLite store, separate from its copied UUID.
+use crate::DbError;
+use std::{fs::OpenOptions, path::Path};
+
+fn physical_id(path: &Path) -> Result<String, DbError> {
+    let result = (|| -> std::io::Result<String> {
+        if path.symlink_metadata()?.file_type().is_symlink() {
+            return Err(std::io::Error::other("Unsupported store alias"));
+        }
+        let mut options = OpenOptions::new();
+        options.read(true);
+        #[cfg(windows)]
+        {
+            use std::os::windows::fs::OpenOptionsExt;
+            options.custom_flags(0x02000000); // FILE_FLAG_BACKUP_SEMANTICS, also for parent directory.
+        }
+        let file = options.open(path)?;
+        #[cfg(unix)]
+        {
+            use std::os::unix::fs::MetadataExt;
+            let value = file.metadata()?;
+            if value.ino() == 0 {
+                return Err(std::io::Error::other("Missing file identity"));
+            }
+            Ok(format!("posix:{}:{}", value.dev(), value.ino()))
+        }
+        #[cfg(windows)]
+        {
+            use std::{ffi::c_void, os::windows::io::AsRawHandle};
+            #[repr(C)]
+            struct FileId {
+                volume: u64,
+                id: [u8; 16],
+            }
+            #[link(name = "kernel32")]
+            unsafe extern "system" {
+                fn GetFileInformationByHandleEx(handle: *mut c_void, class: i32, info: *mut c_void, size: u32) -> i32;
+            }
+            let mut value = FileId { volume: 0, id: [0; 16] };
+            // FileIdInfo returns the full Windows 128-bit file ID, including
+            // on ReFS; this intentionally does not truncate to file_index64.
+            let ok = unsafe {
+                GetFileInformationByHandleEx(
+                    file.as_raw_handle(),
+                    18,
+                    (&mut value as *mut FileId).cast(),
+                    std::mem::size_of::<FileId>() as u32,
+                )
+            };
+            if ok == 0 || value.id.iter().all(|b| *b == 0) {
+                return Err(std::io::Error::other("Missing file identity"));
+            }
+            let id = value.id.iter().map(|b| format!("{b:02x}")).collect::<String>();
+            Ok(format!("windows:{}:{id}", value.volume))
+        }
+        #[cfg(not(any(unix, windows)))]
+        {
+            Err(std::io::Error::other("Unsupported store identity platform"))
+        }
+    })();
+    result.map_err(|_| DbError::Init("Managed operation store identity unavailable".into()))
+}
+
+pub(crate) async fn storage_identity(pool: &sqlx::SqlitePool) -> Result<(String, String), DbError> {
+    use sqlx::Row;
+    let row = sqlx::query("PRAGMA database_list")
+        .fetch_all(pool)
+        .await?
+        .into_iter()
+        .find(|row| row.try_get::<String, _>("name").ok().as_deref() == Some("main"))
+        .ok_or_else(|| DbError::Init("Managed operation store identity unavailable".into()))?;
+    let filename: String = row.try_get("file")?;
+    if filename.is_empty() {
+        return Ok(("memory".into(), "memory".into()));
+    }
+    let path = Path::new(&filename);
+    let parent = path
+        .parent()
+        .ok_or_else(|| DbError::Init("Managed operation store identity unavailable".into()))?;
+    Ok((physical_id(parent)?, physical_id(path)?))
+}
