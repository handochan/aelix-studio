+//! Payload-free managed operation repository contract.
+use crate::{DbError, models::MessageRow};
+
+#[derive(Clone, Debug)]
+pub struct ManagedOperationRow {
+    pub host_store_id: String,
+    pub operation_id: String,
+    pub msg_id: String,
+    pub turn_id: String,
+    pub adapter_store_id: String,
+    pub acp_session_id: String,
+    pub generation: String,
+    pub metadata_id: String,
+    pub state: String,
+}
+
+pub struct AdmitManagedOperation<'a> {
+    pub user_id: &'a str,
+    pub conversation_id: &'a str,
+    pub operation_id: &'a str,
+    pub host_store_id: &'a str,
+    /// Memory-only fingerprint inputs. They are never SQL values.
+    pub canonical_request: &'a [u8],
+    pub command_binding: &'a [u8],
+    /// The ordinary conversation message, committed once with admission.
+    pub message: &'a MessageRow,
+    pub turn_id: &'a str,
+    pub adapter_store_id: &'a str,
+    pub acp_session_id: &'a str,
+    pub generation: &'a str,
+    pub metadata_id: &'a str,
+}
+
+pub fn unavailable() -> DbError {
+    DbError::Init("Managed operation persistence unavailable".into())
+}
