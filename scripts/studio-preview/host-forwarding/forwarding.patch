+++ b/crates/aionui-db/src/repository/sqlite_conversation/operations.rs
@@ -0,0 +1,227 @@
+use super::SqliteConversationRepository;
+use crate::{AdmitManagedOperation, DbError, ManagedOperationRow};
+use hmac::{Hmac, Mac};
+use sha2::Sha256;
+use sqlx::Row;
+
+type HmacSha256 = Hmac<Sha256>;
+const MAX_INPUT: usize = 16 * 1024 * 1024;
+
+fn unavailable() -> DbError {
+    DbError::Init("Managed operation store unavailable".into())
+}
+fn conflict() -> DbError {
+    DbError::Conflict("Managed operation identity conflict".into())
+}
+fn mac(key: &[u8], domain: &[u8], user: &str, conversation: &str, body: &[u8]) -> Result<HmacSha256, DbError> {
+    if key.len() != 32 || body.len() > MAX_INPUT {
+        return Err(unavailable());
+    }
+    let mut mac = HmacSha256::new_from_slice(key).map_err(|_| unavailable())?;
+    for value in [domain, user.as_bytes(), conversation.as_bytes()] {
+        mac.update(value);
+        mac.update(&[0]);
+    }
+    mac.update(body);
+    Ok(mac)
+}
+
+impl SqliteConversationRepository {
+    async fn managed_meta(&self) -> Result<(String, Vec<u8>), DbError> {
+        let identity = super::super::conversation::identity::storage_identity(&self.pool).await?;
+        let query = "SELECT store_id,substr(fingerprint_key,1,33) AS key,root_id,file_id FROM managed_operation_meta WHERE singleton=1";
+        let mut row = sqlx::query(query)
+            .fetch_optional(&self.pool)
+            .await?
+            .ok_or_else(unavailable)?;
+        if row.try_get::<Option<String>, _>("root_id")?.is_none()
+            && row.try_get::<Option<String>, _>("file_id")?.is_none()
+        {
+            sqlx::query("UPDATE managed_operation_meta SET root_id=?,file_id=? WHERE singleton=1 AND root_id IS NULL AND file_id IS NULL")
+                .bind(&identity.0).bind(&identity.1).execute(&self.pool).await?;
+            row = sqlx::query(query)
+                .fetch_optional(&self.pool)
+                .await?
+                .ok_or_else(unavailable)?;
+        }
+        let root: String = row.try_get("root_id").map_err(|_| unavailable())?;
+        let file: String = row.try_get("file_id").map_err(|_| unavailable())?;
+        let store: String = row.try_get("store_id")?;
+        let key: Vec<u8> = row.try_get("key").map_err(|_| unavailable())?;
+        if (root, file) != identity
+            || identity != super::super::conversation::identity::storage_identity(&self.pool).await?
+            || store.len() != 32
+            || !store.bytes().all(|c| c.is_ascii_hexdigit())
+            || key.len() != 32
+        {
+            return Err(unavailable());
+        }
+        Ok((store, key))
+    }
+
+    pub(super) async fn managed_namespace(&self) -> Result<String, DbError> {
+        Ok(self.managed_meta().await?.0)
+    }
+
+    pub(super) async fn managed_lookup(
+        &self,
+        user: &str,
+        conversation: &str,
+        id: &str,
+        store: &str,
+        canonical: Option<&[u8]>,
+    ) -> Result<Option<ManagedOperationRow>, DbError> {
+        let (current, key) = self.managed_meta().await?;
+        if current != store {
+            return Err(conflict());
+        }
+        let row = sqlx::query("SELECT o.operation_id,o.msg_id,o.turn_id,o.adapter_store_id,o.acp_session_id,o.generation,o.metadata_id,o.state,substr(o.fingerprint,1,33) AS fingerprint \
+            FROM managed_operations o INNER JOIN conversations c ON c.id=o.conversation_id AND c.user_id=o.user_id \
+            WHERE o.user_id=? AND o.conversation_id=? AND o.operation_id=?")
+            .bind(user).bind(conversation).bind(id).fetch_optional(&self.pool).await?;
+        let Some(row) = row else {
+            return Ok(None);
+        };
+        if let Some(body) = canonical {
+            let fingerprint: Vec<u8> = row.try_get("fingerprint").map_err(|_| unavailable())?;
+            mac(&key, b"request", user, conversation, body)?
+                .verify_slice(&fingerprint)
+                .map_err(|_| conflict())?;
+        }
+        let result = ManagedOperationRow {
+            host_store_id: current,
+            operation_id: row.try_get("operation_id")?,
+            msg_id: row.try_get("msg_id")?,
+            turn_id: row.try_get("turn_id")?,
+            adapter_store_id: row.try_get("adapter_store_id")?,
+            acp_session_id: row.try_get("acp_session_id")?,
+            generation: row.try_get("generation")?,
+            metadata_id: row.try_get("metadata_id")?,
+            state: row.try_get("state")?,
+        };
+        if [
+            &result.operation_id,
+            &result.msg_id,
+            &result.turn_id,
+            &result.adapter_store_id,
+            &result.acp_session_id,
+            &result.generation,
+            &result.metadata_id,
+        ]
+        .iter()
+        .any(|v| v.is_empty() || v.len() > 128)
+            || ![
+                "accepted",
+                "pending",
+                "recovery_waiting",
+                "completed",
+                "cancelled",
+                "cancelled_before_dispatch",
+                "failed",
+                "interrupted",
+            ]
+            .contains(&result.state.as_str())
+        {
+            return Err(unavailable());
+        }
+        Ok(Some(result))
+    }
+
+    pub(super) async fn managed_admit(
+        &self,
+        p: &AdmitManagedOperation<'_>,
+    ) -> Result<(bool, ManagedOperationRow), DbError> {
+        let (store, key) = self.managed_meta().await?;
+        if store != p.host_store_id || p.message.conversation_id != p.conversation_id {
+            return Err(conflict());
+        }
+        let fingerprint = mac(&key, b"request", p.user_id, p.conversation_id, p.canonical_request)?
+            .finalize()
+            .into_bytes();
+        let command = mac(&key, b"command", p.user_id, p.conversation_id, p.command_binding)?
+            .finalize()
+            .into_bytes();
+        let mut tx = self.pool.begin_with("BEGIN IMMEDIATE").await?;
+        let owner: i64 = sqlx::query_scalar("SELECT EXISTS(SELECT 1 FROM conversations WHERE id=? AND user_id=?)")
+            .bind(p.conversation_id)
+            .bind(p.user_id)
+            .fetch_one(&mut *tx)
+            .await?;
+        if owner != 1 {
+            return Err(DbError::NotFound("Managed conversation unavailable".into()));
+        }
+        let inserted = sqlx::query("INSERT INTO managed_operations(user_id,conversation_id,operation_id,fingerprint,command_fingerprint,msg_id,turn_id,adapter_store_id,acp_session_id,generation,metadata_id,state,created_at,updated_at) \
+            VALUES(?,?,?,?,?,?,?,?,?,?,?,'accepted',?,?) ON CONFLICT(conversation_id,operation_id) DO NOTHING")
+            .bind(p.user_id).bind(p.conversation_id).bind(p.operation_id).bind(fingerprint.as_slice()).bind(command.as_slice())
+            .bind(&p.message.id).bind(p.turn_id).bind(p.adapter_store_id).bind(p.acp_session_id).bind(p.generation).bind(p.metadata_id)
+            .bind(p.message.created_at).bind(p.message.created_at).execute(&mut *tx).await?.rows_affected() == 1;
+        if inserted {
+            let m = p.message;
+            sqlx::query("INSERT INTO messages(id,conversation_id,msg_id,type,content,position,status,hidden,created_at,backend_turn_id) VALUES(?,?,?,?,?,?,?,?,?,?)")
+                .bind(&m.id).bind(&m.conversation_id).bind(&m.msg_id).bind(&m.r#type).bind(&m.content).bind(&m.position)
+                .bind(&m.status).bind(m.hidden).bind(m.created_at).bind(&m.backend_turn_id).execute(&mut *tx).await?;
+            sqlx::query("UPDATE conversations SET updated_at=MAX(updated_at,?) WHERE id=? AND user_id=?")
+                .bind(m.created_at)
+                .bind(p.conversation_id)
+                .bind(p.user_id)
+                .execute(&mut *tx)
+                .await?;
+        }
+        tx.commit().await?;
+        let row = self
+            .managed_lookup(
+                p.user_id,
+                p.conversation_id,
+                p.operation_id,
+                p.host_store_id,
+                Some(p.canonical_request),
+            )
+            .await?
+            .ok_or_else(unavailable)?;
+        Ok((inserted, row))
+    }
+
+    pub(super) async fn managed_command_matches(
+        &self,
+        user: &str,
+        conversation: &str,
+        id: &str,
+        body: &[u8],
+    ) -> Result<bool, DbError> {
+        let (_, key) = self.managed_meta().await?;
+        let stored: Option<Vec<u8>> = sqlx::query_scalar("SELECT substr(o.command_fingerprint,1,33) FROM managed_operations o \
+            INNER JOIN conversations c ON c.id=o.conversation_id AND c.user_id=o.user_id WHERE o.user_id=? AND o.conversation_id=? AND o.operation_id=?")
+            .bind(user).bind(conversation).bind(id).fetch_optional(&self.pool).await?;
+        Ok(stored.is_some_and(|value| {
+            mac(&key, b"command", user, conversation, body).is_ok_and(|m| m.verify_slice(&value).is_ok())
+        }))
+    }
+
+    pub(super) async fn managed_settle(
+        &self,
+        user: &str,
+        conversation: &str,
+        id: &str,
+        state: &str,
+    ) -> Result<(), DbError> {
+        self.managed_meta().await?;
+        if ![
+            "pending",
+            "recovery_waiting",
+            "completed",
+            "cancelled",
+            "cancelled_before_dispatch",
+            "failed",
+            "interrupted",
+        ]
+        .contains(&state)
+        {
+            return Err(unavailable());
+        }
+        sqlx::query("UPDATE managed_operations SET state=?,updated_at=? WHERE user_id=? AND conversation_id=? AND operation_id=? \
+            AND state NOT IN ('completed','cancelled','cancelled_before_dispatch','failed','interrupted') \
+            AND EXISTS(SELECT 1 FROM conversations c WHERE c.id=managed_operations.conversation_id AND c.user_id=managed_operations.user_id)")
+            .bind(state).bind(aionui_common::now_ms()).bind(user).bind(conversation).bind(id).execute(&self.pool).await?;
+        Ok(())
+    }
+}
