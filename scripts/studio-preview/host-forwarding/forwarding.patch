+#[tokio::test]
+async fn unknown_action_and_capacity_reply_while_typed_consent_is_pending() {
+    // Real pinned SDK routing on its JSON-value transport; OS stdio and actual
+    // host qualification are separate probes. Typed permission priority stays
+    // ahead of the catch-all even while a consent task holds the only permit.
+    let (client_wire, agent_wire) = Channel::duplex();
+    let (ready_tx, ready_rx) = oneshot::channel();
+    let (entered_tx, entered_rx) = oneshot::channel();
+    let (release_tx, release_rx) = oneshot::channel();
+    let entered = Arc::new(std::sync::Mutex::new(Some(entered_tx)));
+    let release = Arc::new(std::sync::Mutex::new(Some(release_rx)));
+    let budget = Arc::new(Semaphore::new(1));
+    let client = tokio::spawn(async move {
+        Client
+            .builder()
+            .on_receive_request(
+                async move |_: RequestPermissionRequest, responder, cx| {
+                    let entered = entered.lock().unwrap().take();
+                    let release = release.lock().unwrap().take();
+                    dispatch(cx, &budget, responder, async move {
+                        let _ = entered.unwrap().send(());
+                        let _ = release.unwrap().await;
+                        Ok(RequestPermissionResponse::new(RequestPermissionOutcome::Cancelled))
+                    })
+                },
+                on_receive_request!(),
+            )
+            .on_receive_request(
+                async |_: UntypedMessage, responder, _: ConnectionTo<Agent>| {
+                    let _ = responder.respond_with_error(unsupported());
+                    Ok(())
+                },
+                on_receive_request!(),
+            )
+            .connect_with(client_wire, async move |cx: ConnectionTo<Agent>| {
+                let _ = ready_tx.send(cx);
+                std::future::pending::<Result<(), agent_client_protocol::Error>>().await
+            })
+            .await
+    });
+    let (agent_ready_tx, agent_ready_rx) = oneshot::channel();
+    let agent = tokio::spawn(async move {
+        Agent
+            .builder()
+            .connect_with(agent_wire, async move |cx: ConnectionTo<Client>| {
+                let _ = agent_ready_tx.send(cx);
+                std::future::pending::<Result<(), agent_client_protocol::Error>>().await
+            })
+            .await
+    });
+    let _client_connection = ready_rx.await.unwrap();
+    let connection = agent_ready_rx.await.unwrap();
+    let permission = UntypedMessage::new(
+        "session/request_permission",
+        serde_json::json!({
+            "sessionId": "scope-1", "toolCall": {"toolCallId": "call-1", "title": "Synthetic"},
+            "options": [{"optionId": "once", "name": "Allow", "kind": "allow_once"}]
+        }),
+    )
+    .unwrap();
+    let pending = connection.send_request(permission.clone());
+    let pending_task = tokio::spawn(async move { pending.block_task().await });
+    tokio::time::timeout(Duration::from_secs(2), entered_rx)
+        .await
+        .unwrap()
+        .unwrap();
+    let unknown = UntypedMessage::new(
+        "_client/action/SYNTHETIC_SECRET",
+        serde_json::json!({"secret":"SYNTHETIC_SECRET"}),
+    )
+    .unwrap();
+    let error = tokio::time::timeout(Duration::from_secs(2), connection.send_request(unknown).block_task())
+        .await
+        .unwrap()
+        .unwrap_err();
+    assert_eq!(
+        error.data,
+        Some(serde_json::json!({"kind":"unsupported_client_action","retry":false}))
+    );
+    assert!(!serde_json::to_string(&error).unwrap().contains("SYNTHETIC_SECRET"));
+    let capacity = connection.send_request(permission).block_task().await.unwrap_err();
+    assert_eq!(capacity.data.unwrap()["kind"], "client_capacity_exceeded");
+    assert!(!pending_task.is_finished());
+    release_tx.send(()).unwrap();
+    assert!(pending_task.await.unwrap().is_ok());
+    client.abort();
+    agent.abort();
+    let _ = tokio::join!(client, agent);
+}
