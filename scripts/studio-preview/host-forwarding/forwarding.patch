+//! Narrow status transport: existing process infrastructure, initialize/status
+//! only, no session load/new or native supervisor. Capability is re-negotiated.
+use crate::protocol::{acp::AcpProtocol, acp_init_budget::InitBudget};
+use crate::{AgentError, capability::cli_process::CliAgentProcess};
+use aionui_api_types::{AgentMetadata, ManagedOperationContext, ManagedSessionScope};
+use aionui_common::{CommandSpec, EnvVar};
+use std::{
+    path::{Path, PathBuf},
+    sync::{Arc, OnceLock},
+    time::Duration,
+};
+use tokio::sync::{Semaphore, broadcast, mpsc};
+
+pub struct ManagedExecutionBinding {
+    pub session_id: String,
+    pub scope: ManagedSessionScope,
+    pub metadata_id: String,
+    /// Memory-only input to the repository's keyed command fingerprint.
+    pub command_binding: Vec<u8>,
+}
+
+pub fn managed_command_binding(meta: &AgentMetadata, workspace: &str) -> Result<Vec<u8>, AgentError> {
+    let resolved = managed_status_command(meta, workspace)?.command;
+    let resolved = std::fs::canonicalize(resolved).map_err(|_| unavailable())?;
+    // Credential values (including operator argv/env auth) are not inputs to
+    // an operation fingerprint. Bind the local executable/metadata/workspace
+    // and nonsecret shape; status re-negotiates the ORIGINAL adapter store and
+    // checks the original session/context before reading an outcome.
+    let env_names = meta.env.iter().map(|entry| entry.name.as_str()).collect::<Vec<_>>();
+    serde_json::to_vec(&(&meta.id, &meta.command, resolved, meta.args.len(), env_names, workspace))
+        .map_err(|_| unavailable())
+}
+
+pub fn managed_status_command(meta: &AgentMetadata, workspace: &str) -> Result<CommandSpec, AgentError> {
+    if !meta.enabled {
+        return Err(unavailable());
+    }
+    let configured = meta.command.as_deref().ok_or_else(unavailable)?;
+    let command = if configured == "node" {
+        aionui_runtime::node_runtime::existing_node_runtime_command().ok_or_else(unavailable)?
+    } else {
+        PathBuf::from(configured)
+    };
+    // Status never installs/resolves a new runtime. Packaged/local direct
+    // commands are eligible; absent or changed launch configuration is unknown.
+    if !command.is_absolute() || !command.is_file() || !Path::new(workspace).is_dir() {
+        return Err(unavailable());
+    }
+    let mut args = meta.args.clone();
+    args.push("--operations-status-only".into());
+    Ok(CommandSpec {
+        command,
+        args,
+        env: meta
+            .env
+            .iter()
+            .map(|e| EnvVar {
+                name: e.name.clone(),
+                value: e.value.clone(),
+            })
+            .collect(),
+        cwd: Some(workspace.to_owned()),
+    })
+}
+
+fn unavailable() -> AgentError {
+    AgentError::conflict("Managed operation status unavailable; automatic replay disabled")
+}
+
+struct OwnedStatus(Option<CliAgentProcess>);
+impl Drop for OwnedStatus {
+    fn drop(&mut self) {
+        if let Some(process) = &self.0 {
+            process.force_kill_tree();
+        }
+    }
+}
+
+pub async fn query_managed_operation_status_only(
+    meta: &AgentMetadata,
+    workspace: &str,
+    sid: &str,
+    operation: &ManagedOperationContext,
+) -> Result<serde_json::Value, AgentError> {
+    static BUDGET: OnceLock<Arc<Semaphore>> = OnceLock::new();
+    let _permit = BUDGET
+        .get_or_init(|| Arc::new(Semaphore::new(16)))
+        .clone()
+        .try_acquire_owned()
+        .map_err(|_| unavailable())?;
+    let command = managed_status_command(meta, workspace)?;
+    // The timeout owns the entire process guard. Cancellation/deadline kills
+    // the owned transport tree even while SDK initialize/status is awaiting.
+    tokio::time::timeout(Duration::from_secs(8), async {
+        let process = CliAgentProcess::spawn_for_sdk(command)
+            .await
+            .map_err(|_| unavailable())?;
+        let mut owned = OwnedStatus(Some(process));
+        let process = owned.0.as_ref().unwrap();
+        let (stdin, stdout) = process.take_stdio().await.ok_or_else(unavailable)?;
+        let (events, _) = broadcast::channel(16);
+        let (permissions, _permission_rx) = mpsc::channel(1);
+        let (notifications, _notification_rx) = mpsc::channel(1);
+        let protocol = AcpProtocol::connect(
+            stdin,
+            stdout,
+            events,
+            permissions,
+            notifications,
+            "managed-operation-status",
+            Some(PathBuf::from(workspace)),
+            InitBudget {
+                timeout: Duration::from_secs(3),
+                cold_start: false,
+            },
+        )
+        .await
+        .map_err(|_| unavailable())?;
+        let capability = protocol
+            .managed_capability()
+            .map_err(|_| unavailable())?
+            .ok_or_else(unavailable)?;
+        if !capability.status_only
+            || capability.store_id != operation.store_id
+            || protocol.agent_capabilities().is_none_or(|caps| caps.load_session)
+        {
+            return Err(unavailable());
+        }
+        let result = protocol
+            .operation_status(sid, operation)
+            .await
+            .map_err(|_| unavailable());
+        drop(protocol);
+        process
+            .kill(Duration::from_millis(100))
+            .await
+            .map_err(|_| unavailable())?;
+        owned.0.take();
+        result
+    })
+    .await
+    .map_err(|_| unavailable())?
+}
