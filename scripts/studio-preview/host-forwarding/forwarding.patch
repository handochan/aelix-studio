+    let alias = root.path().join("program");
+    std::fs::write(&first, "first").unwrap();
+    std::fs::write(&second, "second").unwrap();
+    symlink(&first, &alias).unwrap();
+    let mut meta: aionui_api_types::AgentMetadata = serde_json::from_value(serde_json::json!({
+        "id":"managed-1","name":"Synthetic","agent_type":"acp","agent_source":"custom",
+        "enabled":true,"available":true,"sort_order":0,"command":alias,
+        "args":["SYNTHETIC_ARG_SECRET"],"env":[{"name":"TOKEN","value":"SYNTHETIC_ENV_SECRET"}]
+    }))
+    .unwrap();
+    let workspace = root.path().to_str().unwrap();
+    let before = operation::managed_command_binding(&meta, workspace).unwrap();
+    assert!(!String::from_utf8_lossy(&before).contains("SYNTHETIC_"));
+    meta.args[0] = "different credential".into();
+    meta.env[0].value = "different credential".into();
+    assert_eq!(operation::managed_command_binding(&meta, workspace).unwrap(), before);
+    std::fs::remove_file(&alias).unwrap();
+    symlink(&second, &alias).unwrap();
+    assert_ne!(operation::managed_command_binding(&meta, workspace).unwrap(), before);
+    std::fs::remove_file(&alias).unwrap();
+    assert!(operation::managed_command_binding(&meta, workspace).is_err());
+    meta.command = Some("npx".into());
+    meta.resolved_command = Some(first);
+    assert!(operation::managed_status_command(&meta, workspace).is_err());
+}
